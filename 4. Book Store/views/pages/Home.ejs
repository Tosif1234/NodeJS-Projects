<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <%- include('../partials/head') %>
    <style>
        /* Ensures the uploaded image fills the cover perfectly */
        .book-img {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: 0;
        }
        
        /* Forces the inner hardcover border overlay to stay on top of the image */
        .book-cover::after {
            z-index: 2; 
        }

        .cover-title, .cover-author {
            position: relative;
            z-index: 1;
        }

        /* --- BIG CENTERED EMPTY STATE --- */
        .empty-state-wrapper {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 50vh; /* Takes up half the viewport height to stay perfectly centered */
            width: 100%;
            text-align: center;
            padding: 2rem;
        }

        .empty-state-icon {
            font-size: 3rem;
            color: var(--border-color);
            margin-bottom: 1.5rem;
        }

        .empty-state-title {
            font-family: 'Cormorant Garamond', serif;
            font-size: 4.5rem; /* Massive premium heading */
            font-weight: 400;
            color: var(--text-main);
            line-height: 1.1;
            margin-bottom: 1rem;
        }

        .empty-state-subtitle {
            font-family: 'Inter', sans-serif;
            color: var(--text-muted);
            font-size: 1rem;
            text-transform: uppercase;
            letter-spacing: 0.15em;
            margin-bottom: 3rem;
            max-width: 600px;
        }

        .empty-state-btn {
            padding: 1.2rem 2.5rem;
            font-size: 0.85rem;
            transition: 0.3s;
            text-decoration: none;
        }
        
    </style>
</head>
<body>

    <%- include('../partials/navbar') %>

    <main>
        <div class="container">
            
            <% if (typeof books !== 'undefined' && books.length > 0) { %>
                <div class="section-header">
                    <h1>Curated Selections</h1>
                    <p>Discover Our Finest Literature</p>
                </div>
                
                <div class="row">
                    <% books.forEach((book, index) => { %>
                        <div class="col">
                            <a href="/book/<%= book.id%>" style="text-decoration: none; color: inherit;">
                                <div class="card">
    <div class="book-cover cover-<%= (index % 4) + 1 %>">
        <img src="/uploads/<%= book.Image %>" class="book-img" alt="<%= book.Title %>">
        
        <div class="cover-overlay">
            <i class="fa-solid fa-book-open overlay-icon"></i>
        </div>
    </div>
    
    <div class="book-info">
        <div class="info-top">
            <h3 class="info-title"><%= book.Title %></h3>
            <p class="info-author"><i class="fa-solid fa-feather-pointed fa-sm"></i> <%= book.Author %></p>
        </div>
        <div class="info-bottom">
            <span class="info-price"><i class="fa-solid fa-indian-rupee-sign fa-sm"></i> <%= book.Price %></span>
            <span class="info-action">Details <i class="fa-solid fa-arrow-right-long icon-arrow"></i></span>
        </div>
    </div>
</div>
                            </a>
                        </div>
                    <% }) %>
                </div>
                
            <% } else { %>
                
                <div class="empty-state-wrapper">
                    <div class="empty-state-icon">❖</div>
                    <h2 class="empty-state-title">The Archive <br>is Empty</h2>
                    <p class="empty-state-subtitle">There are no titles currently recorded in the database.</p>
                    <a href="/add-book" class="btn-add empty-state-btn">Archive Your First Title</a>
                </div>

            <% } %>

        </div>
    </main>

    <%- include('../partials/footer') %>

</body>
</html>
